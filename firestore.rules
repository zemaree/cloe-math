// rules-status: APPLIED as of 2026-11-22 (saved in the Firebase Console for project cloe-math)
// applied rules = this file: the Cloe uid AND the parent uid can create/update /students/cloe,
//   so the admin reset from the parent profile now succeeds instead of failing with "permission-denied".
// the teacher uid can read /students/cloe but not write it; practice/<uid> stays self-matched per uid.
// mirror only: nothing in the app reads it, do NOT add it to sw.js FILES, and there is no firebase.json
//   or service account here, so re-applying after an edit is a manual save in Console > Firestore > Rules.
// when you change either side, update the rules-status line above and say so in the push message (Rules: applied ...).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progressi reali di Cloe
    match /students/cloe {
      allow read: if request.auth != null
        && request.auth.uid in [
          'gu5hECfhOPbXCCM767IzH12IbmI2',
          'GWk7HNdn8FTIXKyU4OUiBNqStaD2',
          'p4QJoQ0zRANRcdMixjDftb59PgL2'
        ];

      // Cloe writes her own doc; the parent writes it only for the admin reset panel
      allow create, update: if request.auth != null
        && request.auth.uid in [
          'gu5hECfhOPbXCCM767IzH12IbmI2',
          'GWk7HNdn8FTIXKyU4OUiBNqStaD2'
        ];

      allow delete: if false;
    }

    // Modalità Prova: every adult reads and writes only his own test doc
    match /practice/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.uid in [
          'GWk7HNdn8FTIXKyU4OUiBNqStaD2',
          'p4QJoQ0zRANRcdMixjDftb59PgL2'
        ];
    }

    // Everything else stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
